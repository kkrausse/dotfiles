cursor-style = block
theme = Monokai Remastered
# Monokai Remastered makes red and magenta identical and duplicates its bright
# palette. Keep magenta distinct under deuteranopia/protanopia simulation.
palette = 5=#ff6ac1
palette = 13=#ff9ad4
# shell-integration-features = no-cursor
font-family = TX-02
font-size = 14
term=xterm-256color
macos-titlebar-style = native
window-theme = dark
window-save-state = always
#window-width = 100000
#window-height = 100000
window-padding-x = 1,1
window-padding-y = 1,1
# window-step-resize = true
# gtk-adwaita = false
# gtk-titlebar = false
# window-decoration = auto
confirm-close-surface = false
copy-on-select = clipboard
scroll-to-bottom = no-keystroke,no-output
mouse-shift-capture = never
keybind = shift+enter=text:\x1b\r
keybind = super+v=paste_from_clipboard
clipboard-write = allow


# Disable shell integration completely
window-vsync = false
shell-integration-features = no-cursor
